{
  "name": "manumontaraz",
  "version": "0.0.0",
  "description": "manu montaraz web",
  "main": "dist/private/server.js",
  "scripts": {
    "start": "npm run build & node dist/private/server/js/server.js",
    "build": "npm run build:css & npm run build:js & npm run build:private:js & npm run build:html",
    "build:html": "cp -r public/html* dist/public/html ",
    "build:css": "postcss \"public/**/*.css\" --dir dist/public/css",
    "build:js": "esbuild public/**/*.js --outdir=dist/public --outbase=public --minify --format=esm --log-level=info",
    "build:private:js": "cp -r private/* dist/private & esbuild private/**/*.js --outdir=dist/private --outbase=public --minify --format=cjs --log-level=info",
    
    "start_dev": "npm run build_dev & nodemon dist/private/server/js/server.js",
    "build_dev": "npm run build_dev:css & npm run build_dev:js & npm run build_dev:private:js & npm run build_dev:html",
    "build_dev:html": "cp -r public/html* dist/public/html ",
    "build_dev:css": "postcss \"public/**/*.css\" --dir dist/public/css --watch",
    "build_dev:js": "esbuild public/**/*.js --outdir=dist/public --outbase=public --minify --format=esm --watch=forever --log-level=info",
    "build_dev:private:js": "cp -r private/* dist/private & esbuild private/**/*.js --outdir=dist/private --outbase=private --minify --format=cjs --watch=forever --log-level=info",
    
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "Manu Montaraz",
  "license": "AGPL-3.0",
  "devDependencies": {
    "cpx2": "8.0.0",
    "cssnano": "7.1.2",
    "esbuild": "0.27.3",
    "nodemon": "3.1.10",
    "postcss": "8.5.6",
    "postcss-cli": "11.0.1",
    "postcss-nested": "7.0.2",
    "postcss-nesting": "14.0.0"
  },
  "dependencies": {
    "dotenv": "16.5.0",
    "express": "5.1.0",
    "express-rate-limit": "8.0.1",
    "jsonwebtoken": "9.0.2",
    "nodemailer": "7.0.5",
    "pg": "8.16.0",
    "socket.io": "4.8.1",
    "stripe": "18.1.1"
  }
}
